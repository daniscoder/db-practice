[run]
branch = True
source =
    task_1_discount
    task_2_database
    task_3_ui
    task_4_app
# Меряем покрытие кода программы, а не самих тестов.
omit =
    */test_*.py

[report]
show_missing = True
# Строка запуска выполняется только при старте файла как программы.
exclude_also =
    if __name__ == .__main__.:
