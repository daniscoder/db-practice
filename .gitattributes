# Очищенные выгрузки и SQL держим в LF: COPY ... FORMAT csv должен читать их
# одинаково и на Windows, и на сервере БД, а разнобой в переводах строк даёт
# лишние diff-ы на каждой машине.
*.csv text eol=lf
*.sql text eol=lf
*.md  text eol=lf

# Служебные файлы самого git — тоже LF, иначе git на каждом add предупреждает
# о подмене переводов строк в них же.
.gitattributes text eol=lf
.gitignore     text eol=lf

# Исходники ETL не трогаем совсем. В import_partners.csv и import_sales.txt
# CRLF и табуляции — часть предмета разбора: по ним проверяется таблица
# аномалий в README. Нормализация переводов строк подменила бы улику.
# Шаблон с ведущим **/ ловит raw/ на любой глубине: папка задания в каждой
# практике называется по-своему, привязываться к одному пути нельзя.
**/raw/** -text

# PDF — двоичный, никакой подстановки переводов строк.
*.pdf binary
